<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cortez.ivan.ivancortez.controllerApp.UsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Gestor de usuarios" style="-fx-font-size: 18px"/>
    <HBox spacing="10" alignment ="CENTER">
            <TextField fx:id="txtId" promptText="Id" disable="true" prefWidth="40"/>
            <TextField fx:id="txtNombre" promptText="Nombre" prefWidth="100"/>
            <TextField fx:id="txtCorreo" promptText="Correo" prefWidth="100"/>
            <TextField fx:id="txtNumero" promptText="Numero" prefWidth="100"/>
            <TextField fx:id="txtEdad" promptText="Edad" prefWidth="100"/>
            <TextField fx:id="txtEstado" promptText="Estado Civil" prefWidth="100"/>

    </HBox>
    <Button fx:id="btnAgregar" onAction="#handleAgregar" text="Agregar" defaultButton="true" />
    <Button fx:id="btnEliminar" onAction="#handleEliminar" text="Eliminar" disable="true" />

    <TableView fx:id="tableUsuarios" onMouseClicked="#handleAgregar">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colCorreo" text="Correo"/>
            <TableColumn fx:id="colNumero" text="Numero"/>
            <TableColumn fx:id="colEdad" text="Edad"/>
            <TableColumn fx:id="colEstado" text="Estado Civil"/>
        <columns>
    <TableView>
</VBox>
