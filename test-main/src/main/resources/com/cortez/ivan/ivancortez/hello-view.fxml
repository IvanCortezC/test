<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.cortez.ivan.ivancortez.controllerApp.UsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px" text="Gestor de usuarios" />

    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="txtId" disable="true" prefWidth="40" promptText="Id" />
        <TextField fx:id="txtNombre" prefWidth="100" promptText="Nombre" />
        <TextField fx:id="txtCorreo" prefWidth="100" promptText="Correo" />
        <TextField fx:id="txtNumero" prefWidth="100" promptText="Numero" />
        <TextField fx:id="txtEdad" prefWidth="100" promptText="Edad" />
        <TextField fx:id="txtEstado" prefWidth="100" promptText="Estado Civil" />
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnAgregar" defaultButton="true" onAction="#handleAgregar" text="Agregar" />
        <Button fx:id="btnModificar" disable="true" onAction="#handleModificar" text="Modificar" />
        <Button fx:id="btnEliminar" disable="true" onAction="#handleEliminar" text="Eliminar" />
        <Button fx:id="btnLimpiar" onAction="#handleLimpiar" text="Limpiar" />
        <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar" />
        <Button fx:id="btnLeer" onAction="#handleLeer" text="Leer"/>
        <Label fx:id="lblResultado"/>
    </HBox>

    <TableView fx:id="tableUsuarios">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colCorreo" text="Correo" />
            <TableColumn fx:id="colNumero" text="Numero" />
            <TableColumn fx:id="colEdad" text="Edad" />
            <TableColumn fx:id="colEstado" text="Estado Civil" />
        </columns>
    </TableView>
</VBox>
